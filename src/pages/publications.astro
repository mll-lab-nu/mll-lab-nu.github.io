---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import PublicationList from '../components/PublicationList.astro';
---

<Layout
	title="Publications | MLL Lab, Northwestern University"
	description="Publications from the MLL Lab at Northwestern University on agentic reinforcement learning, spatial intelligence, embodied AI agents, and safe reasoning."
>
	<main class="bg-background-light py-12">
		<Container maxWidth="xl">
			<h1 class="text-4xl md:text-6xl font-heading font-bold text-secondary-900 text-center mb-12">Publications</h1>

			<div class="max-w-5xl mx-auto">
				<PublicationList />
			</div>
		</Container>
	</main>
</Layout>
