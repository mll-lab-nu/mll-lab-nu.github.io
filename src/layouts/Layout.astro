---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "MLL Lab (Multimodal Learning with Language), Northwestern University, led by Manling Li: agentic reinforcement learning, spatial intelligence, safe reasoning.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/images/og-mll-lab.png', Astro.site);

const orgJsonLd = {
	"@context": "https://schema.org",
	"@type": "ResearchOrganization",
	"@id": "https://www.mll.lab.northwestern.edu/#organization",
	"name": "MLL Lab",
	"alternateName": [
		"Multimodal Learning with Language Lab",
		"Machine Learning and Language Lab",
		"MLL Lab at Northwestern University",
	],
	"url": "https://www.mll.lab.northwestern.edu/",
	"description":
		"MLL Lab at Northwestern University develops intelligent language and multimodal models that reason, plan, and interact with the physical world, focusing on agentic reinforcement learning, spatial intelligence, embodied AI agents, and safe reasoning.",
	"parentOrganization": {
		"@type": "CollegeOrUniversity",
		"name": "Northwestern University",
		"url": "https://www.northwestern.edu/",
	},
	"founder": {
		"@type": "Person",
		"@id": "https://limanling.github.io/#person",
		"name": "Manling Li",
		"url": "https://limanling.github.io/",
	},
	"knowsAbout": [
		"agentic reinforcement learning",
		"multi-turn reinforcement learning",
		"LLM agents",
		"vision-language model agents",
		"spatial intelligence",
		"embodied AI",
		"safe reasoning",
	],
	"sameAs": [
		"https://github.com/mll-lab-nu",
		"https://mll-lab-nu.github.io/",
	],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

		<!-- Open Graph / Twitter -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="MLL Lab" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="MLL Lab, Multimodal Learning with Language, Northwestern University" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
		
		<link rel="stylesheet" href="/blob.css" />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="bg-background-light">
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--primary-50: #f6f4fc;
		--primary-100: #ece7f9;
		--primary-200: #dcccf3;
		--primary-300: #c3a9e9;
		--primary-400: #a67fdb;
		--primary-500: #8b5bcc;
		--primary-600: #7149ba;
		--primary-700: #5f3ba0;
		--primary-800: #4f3283;
		--primary-900: #412b6a;
		
		--accent-50: #eef2ff;
		--accent-100: #e0e7ff;
		--accent-200: #c7d2fe;
		--accent-300: #a5b4fc;
		--accent-400: #818cf8;
		--accent-500: #6366f1;
		--accent-600: #4f46e5;
		--accent-700: #4338ca;
		--accent-800: #3730a3;
		--accent-900: #312e81;
		
		--text-primary: #1e293b;
		--text-secondary: #475569;
		--bg-light: #fefefe;
		--bg-off: #f8fafc;
		
		--accent-gradient: linear-gradient(
			45deg,
			var(--primary-600),
			var(--primary-800) 30%,
			#ffffff 60%
		);
	}
	
	* {
		box-sizing: border-box;
	}
	
	html {
		font-family: 'Inter', system-ui, sans-serif;
		background-color: var(--bg-light);
		color: var(--text-primary);
		scroll-behavior: smooth;
	}
	
	.container {
		max-width: 1280px;
		margin-left: auto;
		margin-right: auto;
	}
	
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Montserrat', system-ui, sans-serif;
	}
	
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
	
	.subheader {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin: 15px;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		::before,
		::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
