---
import Layout from './Layout.astro';
import Container from '../components/ui/Container.astro';

const { frontmatter } = Astro.props;
const { title, description, date, authors, keywords = [] } = frontmatter;

const published = new Date(date);
const displayDate = published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const postJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"datePublished": published.toISOString().slice(0, 10),
	"url": canonicalURL.href,
	"mainEntityOfPage": canonicalURL.href,
	"keywords": keywords,
	"author": { "@id": "https://www.mll.lab.northwestern.edu/#organization" },
	"publisher": { "@id": "https://www.mll.lab.northwestern.edu/#organization" },
	"isPartOf": { "@type": "Blog", "name": "MLL Lab Blog", "url": new URL('/blog/', Astro.site).href },
};
---

<Layout title={`${title} | MLL Lab Blog`} description={description} ogType="article">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
	<main class="bg-background-light py-12">
		<Container maxWidth="lg">
			<article class="blog-post mx-auto">
				<p class="blog-meta"><a href="/blog">Blog</a> · {displayDate} · {authors}</p>
				<h1>{title}</h1>
				<slot />
			</article>
		</Container>
	</main>
</Layout>

<style is:global>
	.blog-post {
		max-width: 46rem;
		font-size: 18px;
		line-height: 1.75;
		color: var(--text-primary);
	}
	.blog-post .blog-meta {
		font-size: 0.95rem;
		color: var(--text-secondary);
		margin-bottom: 0.75rem;
	}
	.blog-post .blog-meta a {
		color: var(--primary-600);
	}
	.blog-post h1 {
		font-size: 2.25rem;
		line-height: 1.25;
		font-weight: 700;
		margin-bottom: 2rem;
	}
	.blog-post h2 {
		font-size: 1.5rem;
		line-height: 1.35;
		font-weight: 700;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}
	.blog-post p,
	.blog-post ul,
	.blog-post ol,
	.blog-post pre {
		margin-bottom: 1.25rem;
	}
	.blog-post ul {
		list-style: disc;
		padding-left: 1.5rem;
	}
	.blog-post ol {
		list-style: decimal;
		padding-left: 1.5rem;
	}
	.blog-post li {
		margin-bottom: 0.4rem;
	}
	.blog-post a {
		color: var(--primary-600);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.blog-post :not(pre) > code {
		font-size: 0.9em;
		background: var(--primary-50);
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}
	.blog-post pre {
		font-size: 0.85rem;
		line-height: 1.6;
		padding: 1rem 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
	}
	@media (max-width: 640px) {
		.blog-post {
			font-size: 17px;
		}
		.blog-post h1 {
			font-size: 1.75rem;
		}
	}
</style>
